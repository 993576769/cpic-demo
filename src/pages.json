  "condition": {
    "current": 0,
    "list": [
      {
        "name": "home",
        "path": "pages/root/home"
      },
      {
        "name": "tools",
        "path": "pages/root/tools"
      },
      {
        "name": "customers",
        "path": "pages/root/customers"
      },
      {
        "name": "web-site",
        "path": "pages/extra/web-site"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "beansmile-uniapp-boilerplate",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff"
  },
  "tabBar": {
    "custom": true,
    "color": "#999999",
    "selectedColor": "#333333",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/root/home",
        "text": "任务"
      },
      {
        "pagePath": "pages/root/tools",
        "text": "工具"
      },
      {
        "pagePath": "pages/root/customers",
        "text": "顾客"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^common-(.*)": "@/components/common/$1.vue"
    }
