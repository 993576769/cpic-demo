{
  "pages": [
    {
      "path": "pages/root/home"
    },
    {
      "path": "pages/root/tools"
    },
    {
      "path": "pages/root/customers"
    },
    {
      "path": "pages/root/data"
    },
    {
      "path": "pages/root/me"
    },
    {
      "path": "pages/customers/wang/index",
      "style": {
        "navigationBarTitleText": "顾客档案"
      }
    },
    {
      "path": "pages/customers/wang/visit-record",
      "style": {
        "navigationBarTitleText": "拜访记录分析"
      }
    },
    {
      "path": "pages/activity/index",
      "style": {
        "navigationBarTitleText": "活动邀约"
      }
    },
    {
      "path": "pages/material/moments/publish",
      "style": {
        "navigationBarTitleText": "发布朋友圈"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/extra",
      "pages": [
        {
          "path": "web-site"
        }
      ]
    }
  ],
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "home",
        "path": "pages/root/home"
      },
      {
        "name": "tools",
        "path": "pages/root/tools"
      },
      {
        "name": "customers",
        "path": "pages/root/customers"
      },
      {
        "name": "data",
        "path": "pages/root/data"
      },
      {
        "name": "me",
        "path": "pages/root/me"
      },
      {
        "name": "web-site",
        "path": "pages/extra/web-site"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "beansmile-uniapp-boilerplate",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff"
  },
  "tabBar": {
    "custom": true,
    "color": "#999999",
    "selectedColor": "#333333",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/root/home",
        "text": "任务",
        "iconPath": "static/tab-bar/tab-home-inactive.svg",
        "selectedIconPath": "static/tab-bar/tab-home-active.svg"
      },
      {
        "pagePath": "pages/root/tools",
        "text": "工具",
        "iconPath": "static/tab-bar/tab-tools-inactive.svg",
        "selectedIconPath": "static/tab-bar/tab-tools-active.svg"
      },
      {
        "pagePath": "pages/root/customers",
        "text": "顾客",
        "iconPath": "static/tab-bar/tab-customers-inactive.svg",
        "selectedIconPath": "static/tab-bar/tab-customers-active.svg"
      },
      {
        "pagePath": "pages/root/data",
        "text": "数据",
        "iconPath": "static/tab-bar/tab-data-inactive.svg",
        "selectedIconPath": "static/tab-bar/tab-data-active.svg"
      },
      {
        "pagePath": "pages/root/me",
        "text": "我",
        "iconPath": "static/tab-bar/tab-me-inactive.svg",
        "selectedIconPath": "static/tab-bar/tab-me-active.svg"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^common-(.*)": "@/components/common/$1.vue"
    }
  }
}
