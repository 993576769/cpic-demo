{
  "name": "beansmile-uniapp-boilerplate",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">= 18.15.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "pnpm dev:mp-weixin",
    "dev:mp-weixin": "uni -p mp-weixin",
    "lint:js": "cross-env NODE_ENV=production eslint .",
    "lint:ts": "vue-tsc --noEmit",
    "lint:style": "stylelint \"**/*.{scss,vue}\"",
    "build:staging:mp-weixin": "uni build -p mp-weixin --mode staging",
    "deploy:staging:mp-weixin": "node script/deploy/index.js --type mp-weixin --mode staging",
    "build:production:mp-weixin": "uni build -p mp-weixin --mode production",
    "deploy:production:mp-weixin": "node script/deploy/index.js --type mp-weixin --mode production"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4050320250303001",
    "@dcloudio/uni-app-plus": "3.0.0-4050320250303001",
    "@dcloudio/uni-components": "3.0.0-4050320250303001",
    "@dcloudio/uni-h5": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-alipay": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-baidu": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-jd": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-lark": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-qq": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4050320250303001",
    "@dcloudio/uni-mp-xhs": "3.0.0-4050320250303001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-4050320250303001",
    "axios": "^1.8.1",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "meow": "^9.0.0",
    "pinia": "^2.3.1",
    "qs": "6.9.6",
    "url-join": "^5.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "11.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.2.0",
    "@dcloudio/types": "^3.3.2",
    "@dcloudio/uni-automator": "3.0.0-4050320250303001",
