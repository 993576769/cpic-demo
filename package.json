    "@intlify/shared": "^11.1.1",
    "@types/lodash-es": "^4.17.7",
    "@types/minimist": "^1.2.2",
    "@types/node": "^22.13.8",
    "@types/qs": "^6.9.7",
    "@uni-helper/uni-app-types": "^1.0.0-alpha.6",
    "@uni-helper/uni-types": "1.0.0-alpha.6",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "eslint": "^9.9.0",
    "minimist": "^1.2.8",
    "miniprogram-ci": "^2.0.10",
    "sass": "^1.60.0",
